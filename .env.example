# Copy this file to ".env" and fill in your real values.
# .env is read automatically on startup (and should NOT be committed to git).

# --- Required secrets ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token-from-BotFather
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# --- Optional: override defaults from config.py ---
# BOOKS_DIR=./books
# CHROMA_DIR=./vector_store
# OUTPUT_DIR=./packets
# STATE_DB=./state.db

# Models
# SYNTHESIS_MODEL=claude-opus-4-8
# PLANNER_MODEL=claude-haiku-4-5
# SYNTHESIS_MAX_TOKENS=32000
# SYNTHESIS_EFFORT=high

# Retrieval
# RETRIEVAL_TOP_K=28
# CHUNK_SIZE=1800
# CHUNK_OVERLAP=250
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# Daily schedule (local to TIMEZONE)
# DAILY_HOUR=7
# DAILY_MINUTE=0
# TIMEZONE=America/New_York
